# Repland 后端运行配置（复制成服务器上的 <app 目录>/deploy.env，chmod 600）
# 真实值永不进仓库。pm2 经 ecosystem.config.js 的 env 块注入进程环境。

# 监听：公网部署必须只绑回环，由 nginx 反代出 443
REPLAND_SERVER_HOST=127.0.0.1
REPLAND_SERVER_PORT=3120

# 内测门槛：没有短信网关时验证码会直接回显在响应里（dev 出码）。
# 名单非空 → 名单外手机号连码都拿不到；公网部署必须设置。逗号分隔。
REPLAND_SMS_ALLOWED_PHONES=13800000000,13900000000

# 管理端点口令（账号清单 / 微信 complete）。未设置则这些端点开放。
REPLAND_AUTH_ADMIN_TOKEN=change-me

# 自托管微信授权页对外入口；未配微信凭证时微信通道自动降级为「未启用」
REPLAND_PUBLIC_BASE_URL=https://ilovemxt.xyz/repland

# 以下全部可选，缺则对应通道降级不启用（凭证只留服务器）
# REPLAND_SMS_WEBHOOK_URL=            # 有短信网关 → 关掉 dev 出码
# REPLAND_SMS_DEV_MODE=0
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=
# 微信开放平台「网站应用」扫码登录，三项齐全才启用。
# REPLAND_WECHAT_QR_APP_ID=
# REPLAND_WECHAT_QR_APP_SECRET=
# REPLAND_WECHAT_QR_CALLBACK_URL=https://example.com/repland/v1/auth/wechat/qr/callback
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# REPLAND_BITABLE_APP_TOKEN=
# REPLAND_BITABLE_TABLE_ID=
# MEM0_API_KEY=
